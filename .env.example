# ==========================================
# Newsradar — Environment Variables
# Copy to .env and fill required values
# ==========================================

# ─── Required ────────────────────────────

# PostgreSQL password (must be strong!)
DB_PASS=change_me_to_32_char_random_string

# JWT secret (min 32 characters)
JWT_SECRET=change-me-in-production-min-32-chars-long

# AES-256-GCM encryption key (32 bytes = 64 hex characters)
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b

# Your domain (for CORS, OAuth callbacks, YooKassa return URL)
DOMAIN=newsradar.example.com

# ─── Database / Redis (auto-set in Docker Compose) ───

DB_USER=newsradar
DB_NAME=newsradar
DATABASE_URL=postgresql://newsradar:${DB_PASS}@db:5432/newsradar
REDIS_URL=redis://redis:6379/0

# ─── OAuth (optional — if empty, OAuth returns 501 Not Implemented) ───

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ─── AI Platform Provider (OpenRouter) ───

PLATFORM_AI_PROVIDER=openrouter
PLATFORM_AI_BASE_URL=https://openrouter.ai/api/v1
PLATFORM_AI_MODEL=tencent/hy3-preview:free
PLATFORM_AI_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── S3 Storage (optional) ───

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=newsradar-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://cdn.example.com

# ─── Payments — YooKassa (optional) ───

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://${DOMAIN}/subscription/success
