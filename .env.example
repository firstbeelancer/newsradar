# ==========================================
# Newsradar — Environment Variables
# ==========================================

# Infrastructure
DOMAIN=localhost
NODE_ENV=development

# Database
DB_USER=newsradar
DB_PASS=newsradar_dev_password
DB_NAME=newsradar
DATABASE_URL=postgresql://newsradar:newsradar_dev_password@localhost:5432/newsradar

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production-min-32-chars-long

# Encryption (AES-256-GCM — 32 bytes hex = 64 hex chars)
ENCRYPTION_KEY=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a7b8c9d0e1f2a3b4c5d6e1f2a3b4c5d6

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Yandex
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# AI Platform Provider (OpenRouter)
PLATFORM_AI_PROVIDER=openrouter
PLATFORM_AI_BASE_URL=https://openrouter.ai/api/v1
PLATFORM_AI_MODEL=tencent/hy3-preview:free
PLATFORM_AI_API_KEY=

# S3 Storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# Payments — YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
