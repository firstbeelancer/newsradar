{
  "name": "newsradar",
  "version": "3.2.0",
  "private": true,
  "description": "Newsradar — PWA для сбора новостей, AI-скоринга и генерации постов",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "docker compose up -d db redis && concurrently \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:api": "cd packages/api && npm run dev",
    "dev:web": "cd packages/web && npm run dev",
    "dev:worker": "cd packages/worker && npm run dev",
    "build": "npm run build:api && npm run build:web && npm run build:worker",
    "build:api": "cd packages/api && npm run build",
    "build:web": "cd packages/web && npm run build",
    "build:worker": "cd packages/worker && npm run build",
    "db:migrate": "cd packages/api && npx drizzle-kit migrate",
    "db:generate": "cd packages/api && npx drizzle-kit generate",
    "db:studio": "cd packages/api && npx drizzle-kit studio",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0",
    "@vitest/coverage-v8": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
